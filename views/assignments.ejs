<%- include("partials/head") %>
<div class="split-layout">
  <section class="panel form-panel">
    <div class="panel-head"><div><p class="eyebrow">TASK</p><h2><%= editItem ? "課題を編集" : "課題を登録" %></h2></div></div>
    <form method="post" action="/assignments" class="form-grid">
      <input type="hidden" name="id" value="<%= editItem?.id || '' %>">
      <label class="wide">課題名<input required name="title" value="<%= editItem?.title || '' %>" placeholder="例：最終レポート"></label>
      <label class="wide">科目名<input required name="subject" value="<%= editItem?.subject || '' %>" placeholder="関連する授業"></label>
      <label class="wide">締切日時<input required type="datetime-local" name="deadline" value="<%= editItem?.deadline || '' %>"></label>
      <label>進捗率<input required type="number" min="0" max="100" name="progress" value="<%= editItem?.progress ?? 0 %>"></label>
      <label>状態<select name="status"><% ["未着手","作業中","完了"].forEach(x => { %><option <%= editItem?.status === x ? "selected" : "" %>><%= x %></option><% }) %></select></label>
      <label class="wide">メモ<textarea name="memo"><%= editItem?.memo || '' %></textarea></label>
      <%- include("partials/form-actions", { cancel: "/assignments" }) %>
    </form>
  </section>
  <section class="panel wide-panel">
    <div class="panel-head"><div><p class="eyebrow">DEADLINE ORDER</p><h2>課題一覧</h2></div><span class="count"><%= items.length %>件</span></div>
    <% if (!items.length) { %><%- include("partials/empty", { message: "課題はまだ登録されていません" }) %><% } %>
    <div class="management-list"><% items.forEach(item => { %><article><div class="date-box"><strong><%= new Date(item.deadline).getDate() %></strong><small><%= new Date(item.deadline).getMonth()+1 %>月</small></div><div class="grow"><span class="tag coral"><%= item.subject %></span><h3><%= item.title %></h3><p><%= formatDateTime(item.deadline) %></p><div class="progress"><i style="width:<%= item.progress %>%"></i></div><small>進捗 <%= item.progress %>% · <%= item.status %></small></div><%- include("partials/item-actions", { editUrl: `/assignments?edit=${item.id}`, collection: "assignments", id: item.id }) %></article><% }) %></div>
  </section>
</div>
<%- include("partials/foot") %>
