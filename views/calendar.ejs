<%- include("partials/head") %>
<section class="panel">
  <div class="calendar-toolbar"><a class="icon-button" href="/calendar?month=<%= prev %>">‹</a><div><p class="eyebrow">MONTHLY CALENDAR</p><h2><%= base.getFullYear() %>年 <%= base.getMonth()+1 %>月</h2></div><a class="button ghost" href="/calendar">今月</a><a class="icon-button" href="/calendar?month=<%= next %>">›</a></div>
  <div class="calendar-grid"><% ["日","月","火","水","木","金","土"].forEach(x => { %><strong class="cal-head"><%= x %></strong><% }) %>
    <% days.forEach(day => { %><div class="cal-day <%= day.currentMonth ? "" : "muted" %> <%= day.key === today ? "today" : "" %>"><span><%= day.date.getDate() %></span><div class="cal-items"><% (items[day.key] || []).slice(0,3).forEach(item => { %><div style="--color:<%= item.color %>"><i></i><%= item.title %></div><% }) %><% if ((items[day.key] || []).length > 3) { %><small>ほか <%= items[day.key].length-3 %>件</small><% } %></div></div><% }) %>
  </div>
</section>
<%- include("partials/foot") %>
