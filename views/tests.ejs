<%- include("partials/head") %>
<% if (formMode) { %>
<div class="form-page">
  <section class="panel form-panel"><div class="panel-head"><div><p class="eyebrow">EXAM</p><h2><%= editItem ? "テストを編集" : "テストを登録" %></h2></div></div>
    <form method="post" action="/tests" class="form-grid">
      <input type="hidden" name="id" value="<%= editItem?.id || '' %>">
      <label class="wide">科目名
        <select required name="subject" data-test-class-select>
          <option value="">授業を選択してください</option>
          <% classes.forEach(item => { const startPeriod = Number(item.startPeriod || item.period); const endPeriod = Number(item.endPeriod || item.period); const startTime = schoolPeriods.find(period => period.number === startPeriod)?.startTime || item.startTime; %>
            <option value="<%= item.subject %>" data-start="<%= startTime %>" <%= editItem?.subject === item.subject ? "selected" : "" %>><%= item.subject %>（<%= item.weekday %>曜 <%= startPeriod %><%= endPeriod > startPeriod ? `〜${endPeriod}` : '' %>限・<%= startTime %>開始）</option>
          <% }) %>
          <% if (editItem?.subject && !classes.some(item => item.subject === editItem.subject)) { %>
            <option value="<%= editItem.subject %>" selected><%= editItem.subject %></option>
          <% } %>
        </select>
      </label>
      <label class="wide">試験日時<input required type="datetime-local" name="examAt" data-test-datetime value="<%= editItem?.examAt || '' %>"><small>授業を選ぶと開始時刻が自動入力されます。</small></label>
      <label class="wide">試験範囲<input name="scope" value="<%= editItem?.scope || '' %>" placeholder="例：第1章〜第5章"></label>
      <label class="wide">メモ<textarea name="memo"><%= editItem?.memo || '' %></textarea></label>
      <%- include("partials/form-actions", { cancel: "/tests" }) %>
    </form>
  </section>
</div>
<% } else { %>
<section class="panel wide-panel"><div class="panel-head"><div><p class="eyebrow">UPCOMING EXAMS</p><h2>テスト一覧</h2></div><div class="panel-actions"><span class="count"><%= items.length %>件</span><a class="button primary" href="/tests/new">＋ テストを登録</a></div></div>
  <% if (!items.length) { %><%- include("partials/empty", { message: "テストはまだ登録されていません" }) %><% } %>
  <div class="management-list"><% items.forEach(item => { %><article><div class="date-box purple"><strong><%= new Date(item.examAt).getDate() %></strong><small><%= new Date(item.examAt).getMonth()+1 %>月</small></div><div class="grow"><span class="tag purple">テスト</span><h3><%= item.subject %></h3><p><%= formatDateTime(item.examAt) %></p><small><%= item.scope %><%= item.memo ? ` · ${item.memo}` : "" %></small></div><%- include("partials/item-actions", { editUrl: `/tests/${item.id}/edit`, collection: "tests", id: item.id }) %></article><% }) %></div>
</section>
<% } %>
<%- include("partials/foot") %>
